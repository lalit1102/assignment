 <%- include('common/header.ejs') %>
      <%- include('common/sidebar.ejs') %>
  

    <main class="app-main">
      <!--begin::App Content Header-->
      <div class="app-content-header">
        <!--begin::Container-->
        <div class="container-fluid">
          <!--begin::Row-->
          <div class="row">
            <div class="col-sm-6">
              <h3 class="mb-0">General Form</h3>
            </div>
            <div class="col-sm-6">
              <ol class="breadcrumb float-sm-end">
                <li class="breadcrumb-item"><a href="#">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">General Form</li>
              </ol>
            </div>
          </div>
          <!--end::Row-->
        </div>
        <!--end::Container-->
      </div>
      <!--end::App Content Header-->
      <!--begin::App Content-->
      <div class="app-content">
        <!--begin::Container-->
        <div class="container-fluid">
          <!--begin::Row-->
          <div class="row g-4">

            <!--begin::Col-->
            <div class="col-md-6">
              <!--begin::Quick Example-->
              <div class="card card-primary card-outline mb-4">
                <!--begin::Header-->
                <div class="card-header">
                  <div class="card-title">category Example</div>
                </div>
                <!--end::Header-->
                <!--begin::Form-->
                <form method="post" action="/category/ins">
                  <!--begin::Body-->
                  <div class="card-body">
                    <div class="mb-3">
                      <label for="exampleInputEmail1" class="form-label"> category name</label>
                      <input type="text" name="catname" class="form-control" id="exampleInputEmail1"
                        aria-describedby="emailHelp" />
                    </div>

                    <!--end::Body-->
                    <!--begin::Footer-->
                    <div class="card-footer">
                      <button type="submit" class="btn btn-primary">save category</button>
                    </div>
                    <!--end::Footer-->
                </form>
                <!--end::Form-->
              </div>
              <!--end::Quick Example-->
              <!--begin::Input Group-->

              <!--end::Horizontal Form-->
            </div>
            <!--end::Col-->
            <!--begin::Col-->

            <!--end::Col-->
          </div>
          <div class="col-md-6">
            <div class="card mb-4">
              <div class="card-header">
                <h3 class="card-title">Bordered Table</h3>
              </div>
              <!-- /.card-header -->
              <div class="card-body">
                <table class="table table-bordered">
                  <thead>
                    <tr>
                      <th style="width: 10px">#</th>
                      <th>category</th>
                      <th>Actions</th>
                      <!-- <th style="width: 40px">Label</th> -->
                    </tr>
                  </thead>
                  <tbody>
                    <!-- <% if(catdata.length> 0){ %> -->
                      <% catdata.forEach((i, index)=> { %>
                        <tr>
                          <td>
                            <%= index + 1 %>
                          </td>
                          <td>
                            <%= i.catname %>
                          </td>
                          <td>
                            <a href="/category/del/<%= i._id %>" class="btn btn-danger">
                              Delete
                            </a>
                          </td>
                        </tr>
                        <% }) %>
                          <% } else { %>
                            <tr>
                              <td colspan="3">No Data Found</td>
                            </tr>
                            <% } %>
                  </tbody>
                </table>
              </div>
              <!-- /.card-body -->
              <!-- /.card -->
            </div>
            <!--end::Row-->
          </div>
          <!--end::Container-->
        </div>
        <!--end::App Content-->
    </main>
   
<%- include('./common/footer.ejs') %>